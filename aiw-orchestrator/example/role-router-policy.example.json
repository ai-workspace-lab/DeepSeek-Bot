    "mode": "disabled",
    "task_cap": null,
    "daily_cap": null,
    "currency": null
  },
  "limits": {
    "context_reserve_tokens": 32000,
    "catalog_max_age_seconds": 900,
    "max_model_calls_per_task": 8,
    "max_tool_calls_per_task": 8,
    "max_model_switches_per_task": 1,
    "max_role_changes_per_task": 1,
    "max_transport_retries_per_call": 1,
    "effort_rules": {
      "large_context_tokens": 32000,
      "large_context_attachments": 3,
      "short_follow_up_chars": 200
    }
  },
